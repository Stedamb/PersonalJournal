---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getDate } from "@/utils/dateUtils";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { post: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main class="container-sm relative pt-16">
    <div class="flex flex-col items-center">
      <h3 class="text-2xl">{post.data.title}</h3>
      <p>{getDate(post.data.date)}</p>
      <div
        class="FormattedText text-lg flex flex-col w-full px-8 py-12 bg-secondary rounded-xl m-8"
      >
        <Content />
      </div>
      <a
        href="/blog"
        class="text-lg px-8 py-4 bg-secondary hover:bg-secondary-hover rounded-xl transition-colors"
      >
        ← Torna indietro
      </a>
    </div>
  </main>
</Layout>
